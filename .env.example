# Neon / Postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Production requires at least 32 characters. Generate a random secret.
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"
ADMIN_PHONES="9999999999"

# OTP: dev | msg91
# Local dev; hosted testing requires the guarded settings below. Use msg91 after DLT approval.
OTP_MODE="dev"
DEV_OTP_CODE="123456"
# Temporary hosted testing only: code must be 8–10 digits and stays server-only.
ALLOW_PRODUCTION_DEV_OTP="false"
DEV_OTP_PHONES=""
TEST_ADMIN_PHONES=""
# SMS requests per phone/hour. Test mode uses 30 new challenges/hour; resends reuse one.
OTP_MAX_PER_PHONE_HOUR="5"
# MSG91 (only when OTP_MODE=msg91)
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
# Optional: minutes until SMS OTP expires (default 10)
MSG91_OTP_EXPIRY_MIN="10"

# Payments: mock | razorpay
PAYMENT_MODE="razorpay"
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxx"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"

NEXT_PUBLIC_APP_NAME="Budget Worker"
NEXT_PUBLIC_DEFAULT_CITY="Pune"
NEXT_PUBLIC_SITE_DOMAIN="budgetworker.in"
NEXT_PUBLIC_SITE_URL="https://budgetworker.in"
# Comma-separated trusted web origins for browser-based mobile previews.
MOBILE_WEB_ORIGINS=""

# Private interviews. All variables here are server-only.
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_GUARD_SECRET=""
# Canonical origin used for worker invitations and secure mobile handoffs.
APP_URL="https://budgetworker.in"

# Exact trusted origins for the separate worker app (no trailing slash).
WORKER_WEB_ORIGINS=
